rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminUid() { return 'GUClnsyoTbYcM4KyfLbUBpG1HKv1'; }
    function isAdmin() { return signedIn() && request.auth.uid == adminUid(); }
    function bounded(v, lo, hi) { return v is number && v >= lo && v <= hi; }
    function validPlace(d) {
      return d.keys().hasAll(['name','type','lat','lng','radius','limit_db','limit_note','revision','updatedAt'])
        && d.keys().hasOnly(['name','type','lat','lng','radius','limit_db','limit_note','revision','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.type in ['Hospital','Hogar de adultos mayores','Escuela','Salón de eventos','Otro']
        && bounded(d.lat,-90,90) && bounded(d.lng,-180,180) && bounded(d.radius,10,5000)
        && (d.limit_db == null || bounded(d.limit_db,0,150))
        && d.limit_note is string && d.limit_note.size() <= 300
        && d.revision is int && d.revision > 0 && d.updatedAt == request.time;
    }
    function validSettings(d) {
      return d.keys().hasAll(['warnDigital','limitDigital','warnSpl','limitSpl','bandLimit','hold','schedule','levelProfile','revision','updatedAt'])
        && d.keys().hasOnly(['warnDigital','limitDigital','warnSpl','limitSpl','bandLimit','hold','schedule','levelProfile','revision','updatedAt'])
        && bounded(d.warnDigital,-110,0) && bounded(d.limitDigital,-110,0) && d.warnDigital < d.limitDigital
        && bounded(d.warnSpl,0,150) && bounded(d.limitSpl,0,150) && d.warnSpl < d.limitSpl
        && bounded(d.bandLimit,-110,0) && bounded(d.hold,1,60)
        && d.schedule == false && d.levelProfile == 2
        && d.revision is int && d.revision > 0 && d.updatedAt == request.time;
    }
    match /places/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() && validPlace(request.resource.data) && request.resource.data.revision == 1;
      allow update: if isAdmin() && validPlace(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if isAdmin();
    }
    match /settings/global {
      allow read: if signedIn();
      allow create: if isAdmin() && validSettings(request.resource.data) && request.resource.data.revision == 1;
      allow update: if isAdmin() && validSettings(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    // SONOGUARD_AI_BEGIN: ampliación ADITIVA. No modifica places ni settings/global.
    function validSgProfile(d) {
      return d.keys().hasAll(['fullName','organization','type','consent','updatedAt'])
        && d.keys().hasOnly(['fullName','organization','type','consent','updatedAt'])
        && d.fullName is string && d.fullName.size() >= 5 && d.fullName.size() <= 100
        && d.organization is string && d.organization.size() <= 100
        && d.type in ['ciudadano','estudiante','tecnico','institucion']
        && d.consent == true && d.updatedAt == request.time;
    }
    match /sgProfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid && validSgProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    function validSgEvidence(d, id) {
      return d.keys().hasAll(['ownerUid','ownerName','nameMode','db','unit','source','zone','placeName','reportedSource','lat','lng','capturedAt','createdAt','photoPath'])
        && d.keys().hasOnly(['ownerUid','ownerName','nameMode','db','unit','source','zone','placeName','reportedSource','lat','lng','capturedAt','createdAt','photoPath'])
        && d.ownerUid == request.auth.uid
        && d.ownerName is string
        && (d.ownerName == '' || (d.ownerName.size() >= 5 && d.ownerName.size() <= 100
           && exists(/databases/$(database)/documents/sgProfiles/$(request.auth.uid))
           && get(/databases/$(database)/documents/sgProfiles/$(request.auth.uid)).data.fullName == d.ownerName))
        && d.nameMode in ['full','protected']
        && d.db is number
        && ((d.unit == 'dBFS' && d.source == 'microfono' && bounded(d.db,-120,0))
            || (d.unit == 'dB SPL' && d.source == 'declarada' && bounded(d.db,0,160)))
        && d.zone is string && d.zone.size() >= 3 && d.zone.size() <= 120
        && d.placeName is string && d.placeName.size() <= 120
        && d.reportedSource is string && d.reportedSource.size() <= 120
        && ((d.lat == null && d.lng == null) || (bounded(d.lat,-90,90) && bounded(d.lng,-180,180)))
        && d.capturedAt is timestamp
        && d.capturedAt <= request.time + duration.value(5,'m')
        && d.capturedAt >= request.time - duration.value(1,'h')
        && d.createdAt == request.time
        && d.photoPath == 'sgEvidence/' + request.auth.uid + '/' + id + '.jpg';
    }
    match /sgEvidence/{id} {
      allow get, list: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if signedIn() && validSgEvidence(request.resource.data,id);
      allow update: if false; // Evidencia inmutable.
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    // sgAiUsage es accesible exclusivamente desde Cloud Functions (Admin SDK).
    match /sgAiUsage/{id} { allow read, write: if false; }
    match /sgAiChatUsage/{id} { allow read, write: if false; }
    // SONOGUARD_AI_END

    match /{document=**} { allow read, write: if false; }
  }
}
